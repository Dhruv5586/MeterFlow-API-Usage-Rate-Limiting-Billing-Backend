# MeterFlow Environment Configuration

# Application Server
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
LOG_LEVEL=info

# PostgreSQL Connection String
# Example for Neon.tech: postgresql://<user>:<password>@<neon-host>/<dbname>?sslmode=require
# Example for Local: postgresql://postgres:postgres@localhost:5432/meterflow
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meterflow

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
